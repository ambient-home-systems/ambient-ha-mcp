# Required Home Assistant connection settings.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=replace-with-a-long-lived-access-token

# Application settings.
LOG_LEVEL=INFO
MCP_HOST=127.0.0.1
MCP_PORT=8000
REQUEST_TIMEOUT_SECONDS=10
# Slowly changing entity/device/area/floor registries are cached for this many seconds.
# Current entity states are always fetched fresh.
REGISTRY_CACHE_TTL_SECONDS=60
# Read-only recorder/history query bounds. All timestamps supplied to history tools
# must include an explicit UTC offset (or Z).
HISTORY_DEFAULT_LOOKBACK_HOURS=24
HISTORY_MAX_LOOKBACK_HOURS=168
HISTORY_DEFAULT_LIMIT=100
HISTORY_MAX_EVENTS=500
HISTORY_MAX_ENTITIES=50
# Deterministic diagnostic defaults. Ignored IDs are comma-separated domain.object_id values.
BATTERY_WARNING_THRESHOLD=20
IGNORED_DIAGNOSTIC_ENTITIES=
READ_ONLY=true
# Optional strict TOML policy file. Keep READ_ONLY=true in Phase 6. Disabling the
# hard boundary requires both this environment value and the file value to be false.
# POLICY_FILE=/absolute/path/to/policy.toml

# Host-header and browser Origin allowlists for MCP DNS-rebinding protection.
# Keep these local defaults. Do not add a public hostname until the
# bridge has a supported authentication mode and the deployment is hardened.
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
MCP_ALLOWED_ORIGINS=
